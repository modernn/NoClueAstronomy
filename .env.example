# API general configuration
API_TITLE="NoClueAstronomy API"
API_DESCRIPTION="A caching API for astronomical data from various providers"
API_VERSION="1.0.0"
API_LOG_LEVEL="INFO"

# Database configuration
DATABASE_URL="sqlite:///./data/astronomy.db"

# External Astronomy API configuration
ASTRONOMY_API_BASE_URL="https://api.astronomyapi.com/api/v2"
ASTRONOMY_APP_ID="your_app_id"
ASTRONOMY_APP_SECRET="your_app_secret"

# External NASA API configuration
NASA_API_BASE_URL="https://api.nasa.gov"
NASA_API_KEY="your_api_key"

# Cache configuration
CACHE_EXPIRATION_HOURS=24

# Rate limiting configuration
RATE_LIMIT=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BLOCK_TIME=300

# CORS configuration
CORS_ORIGINS=["*"]
CORS_METHODS=["*"]
CORS_HEADERS=["*"]
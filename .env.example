# Astronomy API Credentials
# Sign up at https://astronomyapi.com to get your credentials
ASTRONOMY_APP_ID=your_app_id_here
ASTRONOMY_APP_SECRET=your_app_secret_here

# NASA API Credentials
# Sign up at https://api.nasa.gov to get your API key
NASA_API_KEY=your_nasa_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./data/astronomy.db

# API Configuration
API_LOG_LEVEL=INFO

# Cache Configuration
CACHE_EXPIRATION_HOURS=24

# Rate Limiting Configuration
RATE_LIMIT=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BLOCK_TIME=300
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Streamlit",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m", "streamlit",
                "run",
                "${workspaceFolder}/app.py"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
